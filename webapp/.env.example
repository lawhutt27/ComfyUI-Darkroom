# Copy to .env (or export these) before starting the worker.

# --- AI prompt edits (optional; without a key only the offline clean-up tool is offered) ---
# Nano Banana through OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Or directly through the Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- worker ---
DARKROOM_WORKDIR=./darkroom_data       # projects, originals, exports, LUT library
DARKROOM_PREVIEW_EDGE=1600             # preview proxy long edge (display only)
DARKROOM_PROVIDER_EDGE=1536            # largest image sent to an AI provider
DARKROOM_MAX_UPLOAD_MB=200
DARKROOM_PROVIDER_TIMEOUT=120
DARKROOM_CORS_ORIGINS=http://localhost:5173
# DARKROOM_YUNET_MODEL=/path/to/face_detection_yunet_2023mar.onnx   # offline face model
